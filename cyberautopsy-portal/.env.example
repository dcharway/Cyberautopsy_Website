# Copy to .env.local. Do not commit .env.local.

# ---------------------------------------------------------------------------
# CROSS-APP HANDOFF
# ---------------------------------------------------------------------------
# Shared HMAC secret for verifying session tokens issued by the marketing site.
# MUST be identical to cyberautopsy-site/.env.local.
SESSION_SECRET=change-me-to-a-long-random-string

# Where to redirect unauthenticated users (sign-in page on the marketing site).
MARKETING_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# STORAGE BACKEND
# ---------------------------------------------------------------------------
# Which persistence layer the portal reads/writes.
#
#   filesystem  (default)  — JSON files under .data/. Simple, no external deps.
#   back4app               — Parse Server hosted at Back4App (multi-tenant DB
#                            with query + ACL + File API). Requires the
#                            BACK4APP_* env vars below to be populated.
#
# Migration is store-by-store: as of this commit, only the `clients` store
# supports back4app. Every other store still reads/writes the filesystem
# regardless of this switch.
STORAGE_BACKEND=filesystem

# Back4App application credentials. Create the app at back4app.com → App
# Settings → Security & Keys. Master key is server-only — never expose to
# the browser.
BACK4APP_APP_ID=
BACK4APP_JAVASCRIPT_KEY=
BACK4APP_MASTER_KEY=

# Optional — override if you're using a custom Parse Server URL (self-hosted
# Parse, staging environment, etc.). Default is Back4App's public endpoint.
# BACK4APP_SERVER_URL=https://parseapi.back4app.com/
