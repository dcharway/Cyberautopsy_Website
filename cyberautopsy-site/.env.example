# Copy to .env.local and fill in. Do not commit .env.local.

# ---------------------------------------------------------------------------
# EMAIL (Resend)
# ---------------------------------------------------------------------------
# Used by /api/contact, /api/lead-magnet, /api/auth/register (verification
# emails), and /api/auth/forgot (password reset). Without a key, emails are
# logged to stdout so PM2 can still surface the links.

RESEND_API_KEY=
INTAKE_EMAIL=intake@cyberautopsy.com
INTAKE_FROM=CyberAutopsy Intake <intake@cyberautopsy.com>
EMAIL_FROM=CyberAutopsy <no-reply@cyberautopsy.org>

# ---------------------------------------------------------------------------
# SESSIONS + CROSS-APP HANDOFF
# ---------------------------------------------------------------------------
# Shared HMAC secret for the session token handed off to the GRC portal.
# MUST be identical in cyberautopsy-portal/.env.local. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Where the marketing site sends the user after MFA sign-in.
PORTAL_URL=http://localhost:3100

# Absolute URL of the marketing site (used by Stripe callbacks + email links).
MARKETING_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# ADMIN ACCOUNT
# ---------------------------------------------------------------------------
# Seeded on first store load if ADMIN_PASSWORD is set. Rotating the password
# is a matter of updating the env var and PM2-reloading — the store re-hashes
# on next request.
ADMIN_EMAIL=admin@cyberautopsy.org
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# ---------------------------------------------------------------------------
# STRIPE — SUBSCRIPTIONS
# ---------------------------------------------------------------------------
# The publishable key is bundled into the client — safe to expose.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The secret key stays server-only. Never commit. Never expose to the client.
STRIPE_SECRET_KEY=

# Webhook signing secret from Stripe Dashboard → Developers → Webhooks. The
# endpoint URL to register there is:  https://www.cyberautopsy.org/api/webhooks/stripe
# Events to subscribe:  checkout.session.completed, customer.subscription.*,
#                       invoice.payment_succeeded, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — create Products + recurring Prices once in the Stripe
# dashboard, then paste the price_... IDs here. The plan-name → env-var
# mapping lives in cyberautopsy-site/lib/subscription/plans.ts.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
